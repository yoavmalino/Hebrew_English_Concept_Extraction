        },
        "service_tier": "flex"
      }
    },
    {
      "name": "gemini",
      "kind": "openai_compatible",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "model": "gemini-4-carbon",
      "key_env": "JUDGE_GEMINI_API_KEY",
      "extra": {
        "max_tokens": 65536
      }
    }
  ]
